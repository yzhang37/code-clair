#!/bin/sh
set -eu

# update 只从已有 .clarity 转交升级；安装在哪个目录，就升级那个目录，不要求它是 Git 根目录。
# 文件部署、来源选择和失败恢复仍由同目录 setup.py 负责，本层不初始化 Git 或 current。
if ! script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd); then
    printf '%s\n' 'Clarity update could not locate the existing installation directory.' >&2
    exit 2
fi
case "$script_dir" in
    */.clarity) ;;
    *)
        printf '%s\n' 'This entry only updates an existing project .clarity; use the installer for first installation.' >&2
        exit 2
        ;;
esac
project_dir=$(dirname "$script_dir")

if [ ! -f "$script_dir/setup.py" ] || [ ! -r "$script_dir/setup.py" ]; then
    printf '%s\n' 'The existing installation lacks a readable setup.py; current was not created or reset.' >&2
    exit 2
fi

if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Clarity update requires Python 3.10 or newer; Python 3 was not found.' >&2
    exit 2
fi
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
    printf '%s\n' 'Clarity update requires a working Python 3.10 or newer.' >&2
    exit 2
fi

# 参数原样交给升级命令，保留已选来源；只有用户提供 --source 时才请求切换来源。
exec python3 "$script_dir/setup.py" update "$@" --repo "$project_dir"
