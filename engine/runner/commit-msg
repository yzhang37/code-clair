#!/bin/sh
# clarity-review-hook v1
# Reviewer 始终审核完整暂存快照；本 hook 只决定是否采纳审核结果阻止提交。
# 明确的 Review-Bypass 说明可跳过任意结果，全部已知问题和未完成状态写回本次提交说明。
set -u
# SourceTree 的 PATH 可能不含终端中的 Python，优先使用本机已有的常见安装位置。
PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
export PATH
repo=$(git rev-parse --show-toplevel) || exit 2
cd "$repo" || exit 2

# is_owned_hook() 只认常规脚本的固定前两行，避免外来文件借用正文标记或链接而被覆盖、删除。
is_owned_hook() {
    [ ! -L "$1" ] && [ -f "$1" ] || return 1
    [ "$(sed -n '1p' "$1")" = '#!/bin/sh' ] &&
        [ "$(sed -n '2p' "$1")" = '# clarity-review-hook v1' ]
}

if [ "${1:-}" = --uninstall ]; then
    hooks=$(git rev-parse --git-path hooks) || exit 2
    if is_owned_hook "$hooks/commit-msg"; then
        rm "$hooks/commit-msg" || exit 2
        printf '%s\n' '已移除本程序的提交 hook；规则、案例和审核记录保留。'
    else
        printf '%s\n' '未发现本程序拥有的提交 hook；规则、案例和审核记录保留。'
    fi
    exit 0
fi

if [ "${1:-}" = --install ]; then
    hooks=$(git rev-parse --git-path hooks) || exit 2
    if { [ -e "$hooks/commit-msg" ] || [ -L "$hooks/commit-msg" ]; } && ! is_owned_hook "$hooks/commit-msg"; then
        printf '%s\n' '已有其他程序的 commit-msg hook，未覆盖。' >&2
        exit 2
    fi
    python3 .clarity/engine/runner/install.py --repo . --timeout 600 >/dev/null || exit 2
    cp .clarity/engine/runner/commit-msg "$hooks/commit-msg" || exit 2
    chmod +x "$hooks/commit-msg" || exit 2
    if is_owned_hook "$hooks/pre-commit"; then
        rm "$hooks/pre-commit" || exit 2
    fi
    printf '%s\n' '已接入 SourceTree / Git 提交。要明确跳过，在提交说明中填写 Review-Bypass: 你的说明。'
    exit 0
fi

message=${1:?Git 未提供本次提交说明文件}
state=$(git rev-parse --git-common-dir)/clarity
temporary=$(mktemp -d "${TMPDIR:-/tmp}/clarity-hook.XXXXXX") || exit 2
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
# 只读取提交说明正文中的人的指令，不把详细 diff 或上次生成的报告当成本次指令。
awk '/------------------------ >8 ------------------------/ {exit}
     /^Review-Result-Begin$/ {skip=1; next}
     /^Review-Result-End$/ {skip=0; next}
     !skip {print}' "$message" > "$temporary/body" || exit 2
reason=$(sed -n 's/^Review-Bypass:[[:space:]]*//p' "$temporary/body" | sed '/^[[:space:]]*$/d' | head -n 1)

printf '%s\n' 'Clarity：正在审核完整暂存快照，包括 .clarity 自身。' >&2
python3 "$state/engine/runner/review.py" review --target index --repo "$repo" --config "$state/config.json" > "$temporary/output" 2>&1
status=$?
cat "$temporary/output"
if [ "$status" -eq 0 ]; then
    if grep -qx 'Review-Result-Begin' "$message"; then
        awk '/^Review-Result-Begin$/ {skip=1; next}
             /^Review-Result-End$/ {skip=0; next}
             !skip {print}' "$message" > "$temporary/clean" || exit 2
        cat "$temporary/clean" > "$message" || exit 2
    fi
    exit 0
fi
if [ -z "$reason" ]; then
    printf '\n%s\n%s\n' '本次提交已阻止。要仍然提交，请在提交说明另起一行填写：' 'Review-Bypass: 你的说明（一句话即可，无需 AI 批准）' >&2
    exit "$status"
fi

# 直接取本次 reviewer 输出的报告位置，不从 latest 复用一次旧审核来冒充本次结果。
report=$(sed -n 's/^完整记录：//p' "$temporary/output" | tail -n 1)/result.json
{
    printf '%s\n' 'Review-Result-Begin' "提交者说明：$reason" '本次明确选择仍然提交；以下审核结果没有因此变为通过。'
    if [ -f "$report" ]; then
        # Python 已是 reviewer 的运行依赖；完整问题写回不再取决于可选 jq 是否存在。
        python3 - "$report" <<'PY' || exit 2
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    result = json.load(source)
print("审核状态：" + result["status"])
if result["status"] == "incomplete":
    print("审核未完成：" + result["incomplete_reason"])
else:
    print("发现的问题仍未修复。")
print("问题数：" + str(len(result["findings"])))
for issue in result["findings"]:
    print(f"- {issue['path']}:{issue['line']} [{issue['origin']}] {issue['title']}")
    print("  " + issue["reason"])
    print("  来源依据：" + issue["origin_reason"])
PY
    else
        printf '%s\n' '审核未完成：未取得可读取的结构化报告；原始输出如下。'
        cat "$temporary/output"
    fi
    printf '%s\n' 'Review-Result-End'
} > "$temporary/record" || exit 2

# 替换上次生成的说明，并把本次记录放在 Git 剪切线前，确保其能进入实际 commit message。
awk '/^Review-Result-Begin$/ {skip=1; next}
     /^Review-Result-End$/ {skip=0; next}
     !skip {print}' "$message" > "$temporary/message" || exit 2
awk 'NR==FNR {record=record $0 ORS; next}
     /------------------------ >8 ------------------------/ && !written {printf "\n%s\n", record; written=1}
     {print}
     END {if (!written) printf "\n%s", record}' "$temporary/record" "$temporary/message" > "$temporary/combined" || exit 2
cat "$temporary/combined" > "$message" || exit 2
printf '%s\n' '已按你的明确指令放行；全部已知问题和真实审核状态已写入本次提交说明。' >&2
exit 0
