#!/bin/sh
# clarity-review-hook v1
# Reviewer 始终审核完整暂存快照；本 hook 只决定是否采纳审核结果阻止提交。
# 明确的 Review-Bypass 说明可跳过任意结果，全部已知问题和未完成状态写回本次提交说明。
set -u
# SourceTree 的 PATH 可能不含终端中的 Python，优先使用本机已有的常见安装位置。
PATH="/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"
export PATH
repo=$(git rev-parse --show-toplevel) || exit 2
cd "$repo" || exit 2
state=$(git rev-parse --git-common-dir)/clarity
ui_program="$state/engine/runner/i18n.py"
if [ ! -f "$ui_program" ]; then
    ui_program="$repo/.clarity/engine/runner/i18n.py"
fi

# ui() 只格式化固定界面消息，人的说明和模型证据作为变量原样保留；语言资源缺失时回退英文。
ui() {
    if [ -f "$ui_program" ]; then
        python3 "$ui_program" "$@"
    else
        python3 - "$@" <<'PY'
import sys
print(sys.argv[1].format(**{f"v{index}": value for index, value in enumerate(sys.argv[2:])}))
PY
    fi
}

# is_owned_hook() 只认常规脚本的固定前两行，避免外来文件借用正文标记或链接而被覆盖、删除。
is_owned_hook() {
    [ ! -L "$1" ] && [ -f "$1" ] || return 1
    [ "$(sed -n '1p' "$1")" = '#!/bin/sh' ] &&
        [ "$(sed -n '2p' "$1")" = '# clarity-review-hook v1' ]
}

if [ "${1:-}" = --uninstall ]; then
    hooks=$(git rev-parse --git-path hooks) || exit 2
    if is_owned_hook "$hooks/commit-msg"; then
        rm "$hooks/commit-msg" || exit 2
        ui 'Owned commit hook removed; rules, cases, and review records were retained.'
    else
        ui 'No owned commit hook was found; rules, cases, and review records were retained.'
    fi
    exit 0
fi

if [ "${1:-}" = --install ]; then
    hooks=$(git rev-parse --git-path hooks) || exit 2
    if { [ -e "$hooks/commit-msg" ] || [ -L "$hooks/commit-msg" ]; } && ! is_owned_hook "$hooks/commit-msg"; then
        ui 'Another program owns the existing commit-msg hook; it was not overwritten.' >&2
        exit 2
    fi
    # 首次准备与手动审核共用锁；已有配置原样保留，启用 hook 不重新采用规则或重置模型参数。
    python3 - "$repo" <<'PY' || exit 2
import sys
from pathlib import Path
sys.path.insert(0, str(Path('.clarity/engine/runner').resolve()))
from install import prepare_review, InstallError
from review import control_dir, run_lock, Incomplete
repo = Path(sys.argv[1])
state = control_dir(repo)
state.mkdir(parents=True, exist_ok=True)
try:
    with run_lock(state):
        prepare_review(repo)
except (InstallError, Incomplete, OSError, ValueError) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(2)
PY
    mkdir -p "$hooks" || exit 2
    cp .clarity/engine/runner/commit-msg "$hooks/commit-msg" || exit 2
    chmod +x "$hooks/commit-msg" || exit 2
    if is_owned_hook "$hooks/pre-commit"; then
        rm "$hooks/pre-commit" || exit 2
    fi
    ui 'SourceTree / Git commit review is connected. To bypass this commit, add Review-Bypass: your reason.'
    exit 0
fi

message=${1:?Git did not provide the commit-message file}
temporary=$(mktemp -d "${TMPDIR:-/tmp}/clarity-hook.XXXXXX") || exit 2
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
# 只读取提交说明正文中的人的指令，不把详细 diff 或上次生成的报告当成本次指令。
awk '/------------------------ >8 ------------------------/ {exit}
     /^Review-Result-Begin$/ {skip=1; next}
     /^Review-Result-End$/ {skip=0; next}
     !skip {print}' "$message" > "$temporary/body" || exit 2
reason=$(sed -n 's/^Review-Bypass:[[:space:]]*//p' "$temporary/body" | sed '/^[[:space:]]*$/d' | head -n 1)

ui 'Clarity: reviewing the complete staged snapshot, including .clarity itself.' >&2
python3 "$state/engine/runner/review.py" review --target index --repo "$repo" --config "$state/config.json" > "$temporary/output" 2>&1
status=$?
cat "$temporary/output"
if [ "$status" -eq 0 ]; then
    if grep -qx 'Review-Result-Begin' "$message"; then
        awk '/^Review-Result-Begin$/ {skip=1; next}
             /^Review-Result-End$/ {skip=0; next}
             !skip {print}' "$message" > "$temporary/clean" || exit 2
        cat "$temporary/clean" > "$message" || exit 2
    fi
    exit 0
fi
if [ -z "$reason" ]; then
    ui 'This commit was blocked. To commit anyway, add a separate line to the commit message:' >&2
    ui 'Review-Bypass: your reason (one sentence is enough; no AI approval is required)' >&2
    exit "$status"
fi

# 直接取本次 reviewer 输出的报告位置，不从 latest 复用一次旧审核来冒充本次结果。
report=$(sed -n -e 's/^CLARITY_REPORT_DIR=//p' -e 's/^完整记录：//p' "$temporary/output" | tail -n 1)/result.json
{
    printf '%s\n' 'Review-Result-Begin'
    ui "Submitter's note: {v0}" "$reason" || exit 2
    ui 'The submitter explicitly chose to commit anyway; review results below did not become a pass.' || exit 2
    if [ -f "$report" ]; then
        # Python 已是 reviewer 的运行依赖；完整问题写回不再取决于可选 jq 是否存在。
        python3 - "$report" "$ui_program" <<'PY' || exit 2
import json
import sys
from pathlib import Path
sys.path.insert(0, str(Path(sys.argv[2]).parent))
try:
    from i18n import tr
except ModuleNotFoundError:
    def tr(message, **values):
        return message.format(**values)

with open(sys.argv[1], encoding="utf-8") as source:
    result = json.load(source)
print(tr("Review status: {v0}", v0=result["status"]))
if result["status"] == "incomplete":
    print(tr("Review incomplete: {v0}", v0=result["incomplete_reason"]))
else:
    print(tr("Findings remain unresolved."))
print(tr("Findings: {v0}", v0=len(result["findings"])))
for issue in result["findings"]:
    print(f"- {issue['path']}:{issue['line']} [{issue['origin']}] {issue['title']}")
    print("  " + issue["reason"])
    print(tr("  Provenance: {v0}", v0=issue["origin_reason"]))
PY
    else
        ui 'Review incomplete: no readable structured report was produced. Raw output follows:' || exit 2
        cat "$temporary/output"
    fi
    printf '%s\n' 'Review-Result-End'
} > "$temporary/record" || exit 2

# 替换上次生成的说明，并把本次记录放在 Git 剪切线前，确保其能进入实际 commit message。
awk '/^Review-Result-Begin$/ {skip=1; next}
     /^Review-Result-End$/ {skip=0; next}
     !skip {print}' "$message" > "$temporary/message" || exit 2
awk 'NR==FNR {record=record $0 ORS; next}
     /------------------------ >8 ------------------------/ && !written {printf "\n%s\n", record; written=1}
     {print}
     END {if (!written) printf "\n%s", record}' "$temporary/record" "$temporary/message" > "$temporary/combined" || exit 2
cat "$temporary/combined" > "$message" || exit 2
ui 'Commit allowed by your explicit instruction; all known findings and the actual status were recorded in the commit message.' >&2
exit 0
